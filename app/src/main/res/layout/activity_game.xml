                <ImageView android:id="@+id/coin_07" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:src="@drawable/coin" android:scaleType="fitCenter" android:padding="6dp" android:visibility="invisible" android:contentDescription="coin" />
                <!-- Spacer to match player height so coins stay aligned above player row -->
                <View android:layout_width="match_parent" android:layout_height="70dp" />
            </LinearLayout>
        </FrameLayout>


