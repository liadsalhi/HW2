                <ImageView android:id="@+id/glove_07" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:src="@drawable/glove" android:scaleType="fitCenter" android:visibility="invisible" android:contentDescription="glove" />
                <ImageView android:id="@+id/player_0" android:layout_width="match_parent" android:layout_height="70dp" android:src="@drawable/tyson" android:scaleType="fitCenter" android:visibility="invisible" android:contentDescription="player" />
            </LinearLayout>

            <!-- Coins column (same proportions, so coin_0R aligns with glove_0R) -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
                <ImageView android:id="@+id/coin_00" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:src="@drawable/coin" android:scaleType="fitCenter" android:padding="6dp" android:visibility="invisible" android:contentDescription="coin" />
                <ImageView android:id="@+id/coin_01" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:src="@drawable/coin" android:scaleType="fitCenter" android:padding="6dp" android:visibility="invisible" android:contentDescription="coin" />
                <ImageView android:id="@+id/coin_02" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:src="@drawable/coin" android:scaleType="fitCenter" android:padding="6dp" android:visibility="invisible" android:contentDescription="coin" />
                <ImageView android:id="@+id/coin_03" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:src="@drawable/coin" android:scaleType="fitCenter" android:padding="6dp" android:visibility="invisible" android:contentDescription="coin" />
