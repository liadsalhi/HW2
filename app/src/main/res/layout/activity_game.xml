<?xml version="1.0" encoding="utf-8"?>
<!--
  Game screen layout.
  Road = 5 lanes separated by yellow dividers.
  Each lane column is a FrameLayout that stacks:
    • a vertical LinearLayout of 8 glove ImageViews
    • a vertical LinearLayout of 8 coin ImageViews  (aligned 1-to-1 with gloves)
    • one player ImageView pinned to the bottom of the column.
  Controls (buttons) live below the road and are hidden in Sensor mode.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <!-- ── Status bar ─────────────────────────────────────────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#FFFFFF"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <TextView
            android:id="@+id/txt_coins"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Coins: 0"
            android:textColor="#B8860B"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginEnd="12dp" />

        <TextView
            android:id="@+id/txt_distance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 m"
            android:textColor="#333333"
            android:textSize="14sp" />

        <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

        <ImageView android:id="@+id/heart1"
            android:layout_width="34dp" android:layout_height="34dp"
            android:layout_marginStart="4dp"
            android:src="@drawable/heart_full" android:contentDescription="life" />
        <ImageView android:id="@+id/heart2"
            android:layout_width="34dp" android:layout_height="34dp"
            android:layout_marginStart="4dp"
            android:src="@drawable/heart_full" android:contentDescription="life" />
        <ImageView android:id="@+id/heart3"
            android:layout_width="34dp" android:layout_height="34dp"
            android:layout_marginStart="4dp"
            android:src="@drawable/heart_full" android:contentDescription="life" />

    </LinearLayout>

    <!-- ── Road  (5 lanes + yellow dividers) ──────────────────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:background="#FFFFFF">

        <!-- ══ LANE 0 ══════════════════════════════════════════════════════ -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <!-- Gloves column -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
                <ImageView android:id="@+id/glove_00" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:src="@drawable/glove" android:scaleType="fitCenter" android:visibility="invisible" android:contentDescription="glove" />
                <ImageView android:id="@+id/glove_01" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:src="@drawable/glove" android:scaleType="fitCenter" android:visibility="invisible" android:contentDescription="glove" />
                <ImageView android:id="@+id/glove_02" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:src="@drawable/glove" android:scaleType="fitCenter" android:visibility="invisible" android:contentDescription="glove" />
                <ImageView android:id="@+id/glove_03" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:src="@drawable/glove" android:scaleType="fitCenter" android:visibility="invisible" android:contentDescription="glove" />
