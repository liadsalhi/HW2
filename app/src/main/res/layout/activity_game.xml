                <ImageView android:id="@+id/coin_46" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:src="@drawable/coin" android:scaleType="fitCenter" android:padding="6dp" android:visibility="invisible" android:contentDescription="coin" />
                <ImageView android:id="@+id/coin_47" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:src="@drawable/coin" android:scaleType="fitCenter" android:padding="6dp" android:visibility="invisible" android:contentDescription="coin" />
                <View android:layout_width="match_parent" android:layout_height="70dp" />
            </LinearLayout>
        </FrameLayout>

    </LinearLayout>
    <!-- end road -->

    <!-- ── Controls ───────────────────────────────────────────────────────── -->
    <RelativeLayout
        android:id="@+id/controls_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="14dp"
        android:paddingBottom="26dp"
        android:background="#FFFFFF">

        <Button
            android:id="@+id/btnLeft"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_alignParentStart="true"
            android:layout_marginStart="8dp"
            android:text="←"
            android:textSize="48sp"
            android:textColor="#FFFFFF"
            android:textAllCaps="false"
            android:gravity="center"
            android:includeFontPadding="false"
            android:insetTop="0dp" android:insetBottom="0dp"
            android:insetLeft="0dp" android:insetRight="0dp"
            android:background="@drawable/btn_circle"
            android:stateListAnimator="@null"
            android:elevation="0dp"
            android:padding="0dp" />

        <Button
            android:id="@+id/btnRight"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_alignParentEnd="true"
            android:layout_marginEnd="8dp"
            android:text="→"
            android:textSize="48sp"
            android:textColor="#FFFFFF"
            android:textAllCaps="false"
            android:gravity="center"
            android:includeFontPadding="false"
            android:insetTop="0dp" android:insetBottom="0dp"
            android:insetLeft="0dp" android:insetRight="0dp"
            android:background="@drawable/btn_circle"
            android:stateListAnimator="@null"
            android:elevation="0dp"
            android:padding="0dp" />

    </RelativeLayout>

</LinearLayout>