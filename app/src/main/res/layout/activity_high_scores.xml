<?xml version="1.0" encoding="utf-8"?>
<!-- Leaderboard (top 50%) + Map (bottom 50%) stacked vertically -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@android:color/white">

    <!-- Title bar -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="@string/high_scores_title"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:gravity="center"
        android:background="@color/header_bg" />

    <!-- Fragment 1: leaderboard table (top half) -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/container_leaderboard"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#CCCCCC" />

    <!-- Fragment 2: Google Map (bottom half) -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/container_map"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Back to menu button -->
    <Button
        android:id="@+id/btn_back_menu"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="Back to Menu"
        android:textColor="@color/white"
        android:background="@color/header_bg"
        android:stateListAnimator="@null" />

</LinearLayout>